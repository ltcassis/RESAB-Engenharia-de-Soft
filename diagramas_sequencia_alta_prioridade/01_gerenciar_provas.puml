@startuml
title RF02
autonumber
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam backgroundColor #111111
skinparam defaultFontColor #EEEEEE
skinparam sequence {
 ArrowColor #EEEEEE
 LifeLineBorderColor #BFBFBF
 LifeLineBackgroundColor #168DBB
 ParticipantBorderColor #EEEEEE
 ParticipantBackgroundColor #111111
 ParticipantFontColor #EEEEEE
 ActorBorderColor #EEEEEE
 ActorBackgroundColor #111111
 ActorFontColor #EEEEEE
 GroupBorderColor #EEEEEE
 GroupBackgroundColor #111111
 GroupFontColor #EEEEEE
 GroupHeaderFontColor #EEEEEE
}
skinparam noteBackgroundColor #202020
skinparam noteFontColor #EEEEEE
skinparam noteBorderColor #BFBFBF
actor "Administrador" as P0
boundary ":TelaProva" as P1
control ":ControladorProva" as P2
entity ":RepositorioProva" as P3
entity "prova:Prova" as P4
entity "criterios:CriteriosPontuacao" as P5
P0 -> P1 : confirmarConfiguracao(dados)
activate P1
P1 -> P2 : salvarConfiguracao(dados)
activate P2
P2 -> P3 : buscarPorId(dados.provaId)
activate P3
P3 --> P2 : prova ou nulo
deactivate P3
alt prova == nulo
P2 -> P4 : inicializar(id, olimpiadaId, categoriaId)
activate P4
P4 --> P2 : prova, vinculoValido
deactivate P4
else prova != nulo
P2 -> P4 : verificarVinculo(olimpiadaId, categoriaId)
activate P4
P4 --> P2 : vinculoValido
deactivate P4
end
P2 -> P5 : validar(dados.regras)
activate P5
P5 --> P2 : errosRegras
deactivate P5
P2 -> P4 : validarConfiguracao(dados)
activate P4
P4 --> P2 : errosProva
deactivate P4
alt erros vazios e vinculo valido
P2 -> P5 : configurar(dados.regras)
activate P5
P5 --> P2 : criterios
deactivate P5
P2 -> P4 : configurar(dados, criterios)
activate P4
P4 --> P2 : provaAtualizada
deactivate P4
P2 -> P3 : salvar(provaAtualizada)
activate P3
P3 --> P2 : idProva
deactivate P3
else configuracao invalida
P2 -> P2 : montarErros(errosRegras, errosProva, vinculoValido)
activate P2
P2 --> P2 : retornoErro
deactivate P2
end
P2 --> P1 : retorno
deactivate P2
P1 --> P0 : exibirRetorno(retorno)
deactivate P1
@enduml
